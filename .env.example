# Canonical origin used for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.sam-olayemi.com

# Project inquiries are emailed through the ZeptoMail HTTPS API.
# Without a token, development logs inquiries to the console and
# production answers 503 so the form points visitors to email instead.
ZEPTOMAIL_TOKEN=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
